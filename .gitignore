.venv
# EDA / experiment artifacts (never commit)
.gptq_runs/
rtl/asic/openlane/

# rtl/asic/build/synth_blocks/ holds BOTH the hand-written sky130 synth/STA flow
# (*.sh / *.tcl — ~17 KB, the scripts that produce every fmax number this project
# quotes) and its generated output (*.v netlists, *.log — ~190 MB). Ignoring the
# directory wholesale discarded the SOURCE along with the artifacts, so a fresh
# clone could not run the flow the READMEs document. Ignore the outputs, keep the
# flow.
rtl/asic/build/synth_blocks/*
!rtl/asic/build/synth_blocks/*.sh
!rtl/asic/build/synth_blocks/*.tcl

# sv2v outputs — generated Makefile targets ($(SV2V_OUT)), regenerated by
# `make -C rtl/{asic,fpga} yosys-{asic,fpga}`. The committed copies were from
# 2026-05-26 and ~20 RTL commits stale: they had no div_p6/sqrt_p6/m_exact and
# predated the Port-A split, i.e. they were the machine that silently dropped
# systolic ACCUM drain writes — a build artifact that misrepresented the design.
rtl/asic/build/synth/*.v
rtl/fpga/build/synth/*.v
